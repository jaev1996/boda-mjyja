---
import PhotoFrame from './PhotoFrame.astro';
---

<section class="max-w-4xl mx-auto px-6 py-16 text-center" id="wedding">
  <h2 class="font-script text-4xl md:text-5xl text-wedding-bronze mb-10 reveal">Ceremonia y Recepción</h2>

  <div class="max-w-2xl mx-auto text-center mb-8 reveal">
    <h3 class="font-serif text-3xl text-wedding-bronze mb-3">Ceremonia</h3>
    <p class="font-sans font-medium mb-1">Jueves, 12 de Noviembre de 2026</p>
    <p class="font-sans font-medium mt-3">Santuario de la Virgen del Valle</p>
    <p class="font-sans font-light text-sm mb-4">Isla de Margarita</p>
    <p class="mb-4"><a href="https://maps.app.goo.gl/ZEPkE2i6hitpDdBs7" target="_blank" rel="noopener noreferrer" class="location-link" id="church-map-link">Ubicación</a></p>
    <p class="mt-2"><a href={`${import.meta.env.BASE_URL}/images/Dress Code 2.jpg`} target="_blank" rel="noopener noreferrer" class="text-sm text-wedding-accent underline hover:text-wedding-bronze transition-colors">Dress Code</a></p>
  </div>

  <div class="max-w-2xl mx-auto text-center mb-8 reveal">
    <p class="font-sans text-sm text-wedding-bronze/70 italic mb-4">Transporte: Se proveerá transporte desde el hotel hacia la ceremonia y recepción. Más detalles próximamente.</p>
  </div>

  <div class="max-w-2xl mx-auto text-center mb-8 reveal">
    <h3 class="font-serif text-3xl text-wedding-bronze mb-3">Recepción</h3>
    <p class="font-sans font-medium mb-1">A continuación de la ceremonia</p>
    <p class="font-sans font-light text-lg mb-3">Hasta el amanecer</p>
    <p class="font-sans font-medium">Terraza del Hotel LD Plus Palm Beach</p>
    <p class="font-sans font-light text-sm mb-4">Isla de Margarita</p>
    <p class="mt-2"><a href="https://maps.app.goo.gl/Ay6SfNEjMNiiYHRG6" target="_blank" rel="noopener noreferrer" class="location-link">Ubicación</a></p>
  </div>

  <div class="mt-8 w-full reveal">
    <PhotoFrame src={`${import.meta.env.BASE_URL}/images/ceremonia.jpg`} alt="Ceremonia" className="w-full h-[52vh] sm:h-[60vh] md:h-[80vh]" imgClass="w-full h-full object-cover object-center opacity-75 saturate-[0.85] contrast-[1.08] brightness-[0.93]" />
  </div>
</section>

<script>
  const weddingLink = document.getElementById('church-map-link');
  if (weddingLink && weddingLink.getAttribute('href') === '#') {
    weddingLink.addEventListener('click', (e) => {
      e.preventDefault();
      alert('El enlace de ubicación del Santuario de la Virgen del Valle estará disponible próximamente.');
    });
  }
</script>
