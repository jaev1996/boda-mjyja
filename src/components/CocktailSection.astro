---
import PhotoFrame from './PhotoFrame.astro';
---

<section class="max-w-4xl mx-auto px-6 py-16 text-center" id="cocktail">
  <h2 class="font-script text-4xl md:text-5xl text-wedding-bronze mb-10 reveal">Cóctel de Bienvenida</h2>
  <div class="max-w-lg mx-auto reveal">
    <h3 class="font-serif text-3xl text-wedding-bronze mb-2">Cóctel de Recepción</h3>
    <p class="font-sans font-medium mb-1">Miércoles, 11 de Noviembre de 2026</p>
    <p class="font-sans font-light text-lg mb-4">7:00 PM</p>
    <p class="font-sans font-medium">Terraza del Hotel LD Plus Palm Beach</p>
    <p class="font-sans font-light text-sm mb-4">Isla de Margarita</p>
    <div class="mb-4">
      <span class="inline-block text-xs uppercase tracking-widest text-wedding-cream bg-wedding-bronze px-3 py-1 rounded">Ubicación</span>
    </div>
    <a href="https://maps.app.goo.gl/Ay6SfNEjMNiiYHRG6" target="_blank" rel="noopener noreferrer" class="inline-block text-sm text-wedding-accent underline hover:text-wedding-bronze transition-colors mb-2">Ver Ubicación</a>
    <p class="mt-4"><a href={`${import.meta.env.BASE_URL}/images/Dress Code 1.jpg`} target="_blank" rel="noopener noreferrer" class="text-sm text-wedding-accent underline hover:text-wedding-bronze transition-colors">Dress Code</a></p>
  </div>
  <div class="mt-8 w-full reveal">
    <PhotoFrame src={`${import.meta.env.BASE_URL}/images/Cocteles.jpg`} alt="Cóctel de Bienvenida" className="w-full h-[48vh] sm:h-[58vh] md:h-[80vh]" />
  </div>
</section>
