---
interface Props {
  src: string;
  alt: string;
  className?: string;
  imgClass?: string;
}
const { src, alt, className = 'w-full h-[50vh] sm:h-[58vh] md:h-[80vh]', imgClass = 'w-full h-full object-cover object-center opacity-80 saturate-[0.9] contrast-[1.05]' } = Astro.props;
---

<div class={`photo-frame ${className}`}>
  <img src={src} alt={alt} class={imgClass} />
</div>