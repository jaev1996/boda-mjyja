---
interface Props {
  src: string;
  alt: string;
  className?: string;
  imgClass?: string;
}
const { src, alt, className = 'w-full h-[52vh] sm:h-[60vh] md:h-[80vh]', imgClass = 'w-full h-full object-cover object-center opacity-75 saturate-[0.85] contrast-[1.08] brightness-[0.93]' } = Astro.props;
---

<div class={`photo-frame ${className}`}>
  <img src={src} alt={alt} class={imgClass} />
</div>